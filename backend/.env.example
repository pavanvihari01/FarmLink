# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# To use local SQLite (zero-config), comment out or remove DATABASE_URL.
# The database file will always be backend/farmlink.db, no matter which
# directory you launch uvicorn from.
#
# To use PostgreSQL, leave DATABASE_URL unset here and instead run:
#     docker compose up -d db
#     cd backend
#     alembic upgrade head        # required before first start
#     uvicorn app.main:app --reload
#
DATABASE_URL=postgresql+psycopg://farmlink:farmlink@localhost:5433/farmlink

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
JWT_SECRET=replace-this-in-production
JWT_EXPIRE_MINUTES=720
FRONTEND_ORIGIN=http://localhost:5173

# When false, the demo seeding step is skipped even on a fresh database.
# Set DEMO_MODE=false when pointing at a real PostgreSQL database.
DEMO_MODE=true

# Hours a buyer must wait before ordering the SAME listing again after the
# farmer rejected a previous order on it. Guards against repeated requests for
# produce the farmer already declined.
BUYER_REJECTION_COOLDOWN_HOURS=48

# Distinct reports against a farmer before their lifespan field is locked in
# the create-listing form. Read by GET /reports/against-me.
REPORT_LOCK_THRESHOLD=3
